# ---- Database ---------------------------------------------------------------
# Local: `npm run db:local` starts Postgres on 54329.
# Vercel + Neon: the integration sets DATABASE_URL (pooled) and DATABASE_URL_UNPOOLED (migrations).
DATABASE_URL="postgresql://postgres:postgres@localhost:54329/degreecrm"
DATABASE_URL_UNPOOLED=""

# ---- Hosts ------------------------------------------------------------------
# Hostnames only (no scheme/port). Locally go.localhost resolves to 127.0.0.1.
APP_HOST="localhost"
CLIENT_HOST="go.localhost"
# Public base URL of the CRM (used in links, OAuth metadata, Discord embeds).
APP_URL="http://localhost:3000"

# ---- Auth (Auth.js / NextAuth v5) -------------------------------------------
# openssl rand -base64 32
AUTH_SECRET=""
# Google Cloud OAuth client (Web). Redirect: {APP_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Comma-separated Google accounts allowed to sign in. OWNER_EMAIL is always allowed.
ALLOWED_EMAILS=""
OWNER_EMAIL=""

# ---- Secrets ----------------------------------------------------------------
# 32 random bytes: openssl rand -hex 32 (or -base64 32). Encrypts refresh tokens at rest.
DATA_ENCRYPTION_KEY=""
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to /api/cron/tick.
CRON_SECRET=""

# ---- Integrations -----------------------------------------------------------
# Discord channel #degree-service-call → Integrations → Webhooks. Empty = log only.
DISCORD_SERVICE_WEBHOOK_URL=""

# ---- Claude (proposal drafting) ----------------------------------------------
ANTHROPIC_API_KEY=""
# Optional: defaults to claude-opus-5.
ANTHROPIC_MODEL=""

# ---- Files (Vercel Blob, private store) -------------------------------------
# Set automatically when the Blob store is connected. Empty = local .blobdata/ folder.
BLOB_READ_WRITE_TOKEN=""

# ---- Quo (texts) ------------------------------------------------------------
QUO_API_KEY=""
# The company number's id in Quo (PN…).
QUO_INBOX_ID=""

# ---- Google Maps --------------------------------------------------------------
# Server key: Geocoding API (coordinates + county for sales tax). No referrer restriction.
GOOGLE_MAPS_API_KEY=""
# Browser key: Maps JavaScript API + Places API (New), restricted to your domains.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# ---- Website lead form ------------------------------------------------------
# Origins allowed to POST to /api/intake/web (comma-separated).
INTAKE_ALLOWED_ORIGINS="https://cincydegreeofcomfort.com,https://www.cincydegreeofcomfort.com"
# Optional Cloudflare Turnstile secret; when set, the form must send a turnstile token.
TURNSTILE_SECRET_KEY=""
# Shared secret for /api/intake/jotform?secret=... (only if you use Jotform).
INTAKE_WEBHOOK_SECRET=""

# ---- Testing only -----------------------------------------------------------
# Enables a password-less test sign-in. Never set in production.
E2E_AUTH=""
# Use a canned proposal draft instead of calling Claude (tests / offline dev).
AI_MOCK=""
