// Degree of Comfort CRM — see SPEC.md "Data model".
// Conventions: money is integer cents, timestamps are UTC, every table has createdAt/updatedAt.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  owner
  tech
}

enum CustomerType {
  residential
  commercial
}

enum Trade {
  hvac
  plumbing
  electrical
}

enum LeadSource {
  phone
  web_form
  referral
  repeat_customer
  mcp
  other
}

/// Pipeline stages in order (SPEC.md "Job pipeline"). `lost` is outside the order.
enum LeadStage {
  new
  follow_up
  estimate_scheduled
  estimate_sent
  estimate_approved
  job_scheduled
  job_in_progress
  job_completed
  invoiced
  payment_complete
  review_requested
  lost
}

model User {
  id                        String    @id @default(cuid())
  name                      String
  email                     String    @unique
  role                      Role      @default(tech)
  phone                     String?
  image                     String?
  active                    Boolean   @default(true)
  /// Encrypted with DATA_ENCRYPTION_KEY. Set when a tech connects Google Calendar.
  googleRefreshToken        String?
  googleCalendarEmail       String?
  googleCalendarConnectedAt DateTime?
  /// Last time the inbound calendar poll ran for this user.
  googleCalendarPolledAt    DateTime?
  lastLoginAt               DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  assignedLeads Lead[]         @relation("LeadAssignee")
  activities    Activity[]
  oauthCodes    OAuthCode[]
  oauthTokens   OAuthToken[]
  proposals     Proposal[]
  termsVersions TermsVersion[]
  jobs          Job[]          @relation("JobAssignee")
  visits        Visit[]        @relation("VisitTech")
  messagesSent  Message[]
}

model Customer {
  id           String       @id @default(cuid())
  name         String
  email        String?
  /// E.164, e.g. +15135550123
  phone        String?
  type         CustomerType @default(residential)
  quickbooksId String?
  smsOptOut    Boolean      @default(false)
  notes        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  properties Property[]
  leads      Lead[]
  activities Activity[]
  messages   Message[]

  @@index([phone])
  @@index([email])
}

model Property {
  id         String   @id @default(cuid())
  customerId String
  street     String
  unit       String?
  city       String   @default("Cincinnati")
  state      String   @default("OH")
  zip        String?
  /// e.g. "Hamilton County" — decides the sales tax rate in Ohio.
  county     String?
  lat        Float?
  lng        Float?
  /// Access instructions, equipment on site, etc.
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  leads    Lead[]
  jobs     Job[]

  @@index([customerId])
}

model Lead {
  id             String     @id @default(cuid())
  customerId     String
  propertyId     String?
  /// Short headline for cards and Discord, e.g. "AC not cooling upstairs".
  title          String
  source         LeadSource @default(phone)
  trade          Trade
  stage          LeadStage  @default(new)
  notes          String?
  assignedToId   String?
  stageChangedAt DateTime   @default(now())
  lastActivityAt DateTime   @default(now())
  lostReason     String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  customer    Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  property    Property?        @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  assignedTo  User?            @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  activities  Activity[]
  proposals   Proposal[]
  photos      LeadPhoto[]
  jobs        Job[]
  visits      Visit[]
  enrollments Enrollment[]
  messages    Message[]
  bookings    BookingRequest[]

  @@index([stage])
  @@index([assignedToId])
  @@index([customerId])
}

/// Timeline + audit log. Every stage change, note, MCP call and intake writes one.
model Activity {
  id         String   @id @default(cuid())
  /// e.g. lead_created, stage_changed, note, assigned, mcp_call, web_form
  type       String
  body       String?
  data       Json?
  leadId     String?
  customerId String?
  /// Null for system / client actions.
  userId     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  lead     Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
  @@index([customerId, createdAt])
}

/// Outbound notifications queue (Discord now; more channels later) so an outage never blocks the app.
model OutboxEvent {
  id            String    @id @default(cuid())
  channel       String
  payload       Json
  status        String    @default("pending") // pending | sent | failed
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  lastError     String?
  sentAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, nextAttemptAt])
}

// ---- OAuth 2.1 authorization server for the MCP connector -----------------

model OAuthClient {
  /// The client_id handed out by dynamic client registration.
  id           String   @id
  name         String?
  redirectUris String[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  codes  OAuthCode[]
  tokens OAuthToken[]
}

model OAuthCode {
  id            String    @id @default(cuid())
  /// sha256 of the code; the plain code is never stored.
  codeHash      String    @unique
  clientId      String
  userId        String
  redirectUri   String
  codeChallenge String
  scope         String?
  resource      String?
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  client OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OAuthToken {
  id               String    @id @default(cuid())
  accessTokenHash  String    @unique
  refreshTokenHash String    @unique
  clientId         String
  userId           String
  scope            String?
  resource         String?
  expiresAt        DateTime
  refreshExpiresAt DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  client OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Owner-editable settings (key → JSON), e.g. "discord.stages".
model Setting {
  key       String   @id
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---- Phase 2: price book, tax, terms, proposals -----------------------------

enum PriceCategory {
  equipment
  material
  labor
  fee
}

enum Tier {
  good
  better
  best
}

enum ProposalStatus {
  draft
  sent
  viewed
  signed
  superseded
}

model PriceBookItem {
  id          String        @id @default(cuid())
  /// Null = usable for every trade.
  trade       Trade?
  category    PriceCategory @default(material)
  name        String
  description String?
  sku         String?
  unit        String        @default("ea")
  costCents   Int?
  priceCents  Int
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  lineItems LineItem[]

  @@index([trade, active])
}

/// Sales tax by state + county. A row with county = "" is the statewide fallback.
model TaxRate {
  id        String   @id @default(cuid())
  state     String
  county    String   @default("")
  /// Basis points: 780 = 7.80%.
  rateBps   Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([state, county])
}

/// Terms & Conditions, versioned. A version is never edited; saving creates the next one.
model TermsVersion {
  id          String   @id @default(cuid())
  version     Int      @unique
  /// Full T&C, markdown.
  body        String
  /// 6–8 plain-English lines shown above the checkbox, one per line. Supports {deposit} and {expires}.
  keyTerms    String
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)
  proposals Proposal[]
}

model LeadPhoto {
  id          String   @id @default(cuid())
  leadId      String
  /// Private Vercel Blob pathname.
  blobPath    String
  contentType String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

/// One row per version; a revision creates a new row (SPEC.md "Data model").
model Proposal {
  id                   String         @id @default(cuid())
  leadId               String
  version              Int
  status               ProposalStatus @default(draft)
  /// Random 32-char link token; set when sent.
  token                String?        @unique
  summary              String         @default("")
  assumptions          String[]
  exclusions           String[]
  recommendedTier      Tier?
  selectedOptionId     String?
  /// Sales tax snapshot (basis points) and where it came from, e.g. "Hamilton County, OH".
  taxRateBps           Int            @default(0)
  taxLabel             String         @default("")
  /// Null = company rule (e.g. 50% under $5k, 30% above), decided per option total.
  depositPercent       Int?
  termsVersionId       String?
  /// What the drafter was given (notes / transcript), for reference.
  inputNotes           String?
  targetMarginPercent  Int?
  aiModel              String?
  sentAt               DateTime?
  expiresAt            DateTime?
  firstViewedAt        DateTime?
  lastViewedAt         DateTime?
  viewCount            Int            @default(0)
  gateFailures         Int            @default(0)
  lockedAt             DateTime?
  /// Cached PDF of the selected option (private Blob pathname) and the state it was rendered from.
  pdfPath              String?
  pdfKey               String?
  /// E-signature (Documenso)
  signedAt             DateTime?
  signedOptionId       String?
  /// When the deposit was recorded (card, check, financing…).
  depositPaidAt        DateTime?
  quickbooksEstimateId String?
  createdById          String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  lead      Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdBy User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  terms     TermsVersion?    @relation(fields: [termsVersionId], references: [id], onDelete: Restrict)
  options   ProposalOption[]
  signature Signature?
  payments  Payment[]
  job       Job?

  @@unique([leadId, version])
}

model ProposalOption {
  id            String   @id @default(cuid())
  proposalId    String
  tier          Tier
  title         String
  summary       String   @default("")
  /// 4–6 bullet highlights for the option card.
  highlights    String[]
  warrantyText  String   @default("")
  sortOrder     Int
  /// Kept in sync with line items by the service (required lines only).
  subtotalCents Int      @default(0)
  taxCents      Int      @default(0)
  totalCents    Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  proposal  Proposal   @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  lineItems LineItem[]

  @@unique([proposalId, tier])
}

model LineItem {
  id              String   @id @default(cuid())
  optionId        String
  description     String
  qty             Float    @default(1)
  unit            String   @default("ea")
  unitCents       Int
  /// Optional add-ons are listed but not included in the total.
  isOptional      Boolean  @default(false)
  /// Claude couldn't find this in the price book; the owner must set a price before sending.
  needsPrice      Boolean  @default(false)
  priceBookItemId String?
  sortOrder       Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  option        ProposalOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  priceBookItem PriceBookItem? @relation(fields: [priceBookItemId], references: [id], onDelete: SetNull)

  @@index([optionId])
}

// ---- Phase 3: signing and payments ------------------------------------------

/// Built-in e-signature (ESIGN / Ohio UETA): who signed what, when, how, with the evidence to show it.
model Signature {
  id                 String    @id @default(cuid())
  proposalId         String    @unique
  optionId           String
  /// drawn | typed | paper (owner recorded a paper signature)
  method             String
  /// Typed signatures: the name as typed. Drawn: the image is in private Blob.
  typedSignature     String?
  signatureImagePath String?
  signerName         String
  signerEmail        String
  ip                 String?
  userAgent          String?
  /// The customer passed the phone-last-4 check on this link.
  phoneVerified      Boolean   @default(false)
  /// Signed in person on a staff member's device ("Present to customer").
  presentedByName    String?
  consentAt          DateTime?
  signedAt           DateTime
  termsVersion       Int
  termsAcceptedAt    DateTime
  /// sha256 of what was agreed (option, lines, totals, terms) at signing time.
  contentHash        String
  /// Signed PDF (with the audit certificate) in private Blob, and its sha256.
  signedPdfPath      String?
  signedPdfHash      String?
  copySentAt         DateTime?
  recordedById       String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
}

enum PaymentKind {
  deposit
  progress
  final
}

enum PaymentMethod {
  card
  ach
  check
  cash
  financing
  quickbooks_invoice
  other
}

enum PaymentStatus {
  succeeded
  failed
  pending
}

model Payment {
  id                  String        @id @default(cuid())
  proposalId          String?
  jobId               String?
  kind                PaymentKind
  method              PaymentMethod
  amountCents         Int
  status              PaymentStatus
  quickbooksChargeId  String?       @unique
  quickbooksPaymentId String?
  cardLast4           String?
  note                String?
  failureReason       String?
  createdById         String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  proposal Proposal? @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  job      Job?      @relation(fields: [jobId], references: [id], onDelete: SetNull)
}

// ---- Phase 4: jobs, visits, calendar ----------------------------------------

enum JobStatus {
  unscheduled
  scheduled
  in_progress
  completed
  invoiced
  paid
  cancelled
}

/// Created when the deposit is recorded.
model Job {
  id                   String    @id @default(cuid())
  leadId               String
  proposalId           String    @unique
  propertyId           String?
  title                String
  status               JobStatus @default(unscheduled)
  assignedToId         String?
  totalCents           Int
  depositCents         Int
  /// Estimated hours on site, for the dispatch board.
  durationHours        Float     @default(4)
  quickbooksEstimateId String?
  quickbooksInvoiceId  String?
  invoiceSentAt        DateTime?
  invoiceLink          String?
  completedAt          DateTime?
  paidAt               DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  lead       Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  proposal   Proposal  @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  assignedTo User?     @relation("JobAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  visits     Visit[]
  payments   Payment[]

  @@index([status])
  @@index([leadId])
}

enum VisitKind {
  estimate
  job
}

enum VisitStatus {
  scheduled
  en_route
  in_progress
  done
  rescheduled
  cancelled
}

/// One trip to the property. Estimates and job days are visits; each syncs to the tech's Google Calendar.
model Visit {
  id                 String      @id @default(cuid())
  leadId             String
  jobId              String?
  kind               VisitKind
  techId             String
  start              DateTime
  end                DateTime
  status             VisitStatus @default(scheduled)
  notes              String?
  googleEventId      String?
  /// The tech whose calendar holds googleEventId (moves when the visit is reassigned).
  googleEventOwnerId String?
  /// pending | synced | error | skipped
  syncState          String      @default("pending")
  syncError          String?
  enRouteAt          DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  lead        Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  job         Job?         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  tech        User         @relation("VisitTech", fields: [techId], references: [id], onDelete: Restrict)
  enrollments Enrollment[]

  @@index([techId, start])
  @@index([start])
  @@index([syncState])
}

// ---- Phase 6: texting -------------------------------------------------------

/// A drip / reminder sequence. `trigger` is a lead stage, or "estimate_visit" / "job_visit" for appointment reminders.
model Sequence {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  trigger   String
  /// Stop when the lead moves past this stage (null = only the generic stop rules).
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  steps       SequenceStep[]
  enrollments Enrollment[]
}

model SequenceStep {
  id          String   @id @default(cuid())
  sequenceId  String
  sortOrder   Int
  /// "enrolled": hours after enrolling. "visit_start" / "visit_end": hours relative to the visit (negative = before).
  anchor      String   @default("enrolled")
  offsetHours Float    @default(0)
  template    String
  /// Let Claude lightly personalize the wording from the lead notes.
  personalize Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sequence Sequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  @@index([sequenceId, sortOrder])
}

model Enrollment {
  id            String    @id @default(cuid())
  sequenceId    String
  leadId        String
  visitId       String?
  stepIndex     Int       @default(0)
  nextSendAt    DateTime?
  /// active | completed | stopped
  status        String    @default("active")
  stoppedReason String?
  failures      Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sequence Sequence  @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  lead     Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  visit    Visit?    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([status, nextSendAt])
  @@index([leadId])
}

/// Every text in or out, one thread per customer.
model Message {
  id           String   @id @default(cuid())
  customerId   String
  leadId       String?
  /// in | out
  direction    String
  body         String
  /// queued | sent | delivered | failed | received
  status       String
  quoMessageId String?  @unique
  enrollmentId String?
  sentById     String?
  error        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  lead       Lead?       @relation(fields: [leadId], references: [id], onDelete: SetNull)
  enrollment Enrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  sentBy     User?       @relation(fields: [sentById], references: [id], onDelete: SetNull)

  @@index([customerId, createdAt])
}

/// A customer's preferred day + 3-hour arrival window, waiting for the owner to confirm.
model BookingRequest {
  id         String   @id @default(cuid())
  leadId     String
  /// Eastern calendar date, YYYY-MM-DD.
  date       String
  /// Arrival window id, e.g. "09-12".
  window     String
  altDate    String?
  altWindow  String?
  /// Optional third choice.
  alt2Date   String?
  alt2Window String?
  /// pending | confirmed | declined
  status     String   @default("pending")
  /// website | claude | staff
  source     String   @default("website")
  visitId    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([leadId])
}
