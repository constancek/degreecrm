    "worker": "tsx worker/index.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@dnd-kit/core": "^6.3.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
